# Transient lock dirs for the atomic id allocators (the counters themselves —
# backlog/.next-id and sessions/.next-id — ARE committed; only the locks aren't)
backlog/.next-id.lock
sessions/.next-id.lock

# Live status snapshot — ephemeral, regenerated by .claude/bin/status (committed
# session docs are the durable state; .status.md is the human-facing glance)
.status.md

# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Dependencies / build
node_modules/
dist/
build/
.venv/

# OS / editor cruft
.DS_Store
*.log
