{
  "version": 1,
  "_doc": "Capability module registry. Types in registry.d.ts. Seed trees in <id>/seed/. Consumed by TerMinal (src/main/modules.ts). Detection is authoritative from .TerMinal/template.json modules{}; detect.markers are the filesystem fallback. All tools free & self-hosted; DigitalOcean is the only paid line.",
  "modules": [
    {
      "id": "health",
      "title": "Health",
      "summary": "/healthz + /readyz endpoint, red/green status, morning health-check cron.",
      "scope": "repo",
      "seed": { "root": "seed", "preserve": ["src/health.ts"] },
      "detect": { "markers": ["docs/runbooks/health.md"], "requireAll": ["docs/runbooks/health.md"] },
      "surface": {
        "adminLabel": "Health",
        "group": "runtime",
        "docPath": "docs/runbooks/health.md",
        "data": [{ "kind": "http", "url": "http://localhost:3000/healthz" }],
        "widgets": [{ "kind": "status", "source": 0, "title": "Health" }],
        "links": [{ "label": "Open /healthz", "url": "http://localhost:3000/healthz" }],
        "actions": [
          { "id": "seed", "label": "Seed", "kind": "seed" },
          { "id": "run", "label": "Run health check", "kind": "run-check", "agentId": "health" },
          { "id": "cron", "label": "Toggle morning cron", "kind": "toggle-schedule", "agentId": "health" }
        ]
      },
      "automate": {
        "agents": ["health"],
        "schedules": [{ "agentId": "health", "spec": { "minute": 0, "hour": 8 } }],
        "filesTickets": true
      }
    },
    {
      "id": "feedback",
      "title": "Feedback",
      "summary": "In-app feedback capture → local store → auto-filed tickets.",
      "scope": "repo",
      "seed": { "root": "seed", "preserve": ["src/feedback.ts"], "gitignore": [".TerMinal/telemetry/"] },
      "detect": { "markers": [".agents/feedback-triage.md"], "requireAll": [".agents/feedback-triage.md"] },
      "surface": {
        "adminLabel": "Feedback",
        "group": "growth",
        "docPath": "docs/feedback.md",
        "data": [{ "kind": "file", "path": ".TerMinal/telemetry/feedback.jsonl" }],
        "widgets": [{ "kind": "table", "source": 0, "title": "Recent feedback" }],
        "actions": [
          { "id": "seed", "label": "Seed", "kind": "seed" },
          { "id": "triage", "label": "Triage now", "kind": "run-check", "agentId": "feedback-triage" }
        ]
      },
      "automate": {
        "agents": ["feedback-triage"],
        "schedules": [{ "agentId": "feedback-triage", "spec": { "minute": 30, "hour": 8 } }],
        "filesTickets": true
      }
    },
    {
      "id": "api-docs",
      "title": "API Docs",
      "summary": "Self-hosted OpenAPI docs at /docs (zod → openapi.json → self-contained HTML).",
      "scope": "repo",
      "seed": { "root": "seed", "preserve": ["docs/api/contract.config.ts", "src/api/server.ts"] },
      "detect": { "markers": ["docs/api/README.md", "docs/api/index.html"], "requireAll": ["docs/api/README.md"] },
      "surface": {
        "adminLabel": "API Docs",
        "group": "api-docs",
        "docPath": "docs/api/README.md",
        "data": [{ "kind": "http", "url": "http://localhost:3000/v1/schema" }],
        "widgets": [{ "kind": "stat", "source": 0, "title": "Endpoints" }],
        "links": [{ "label": "Open /docs", "url": "http://localhost:3000/docs" }],
        "actions": [
          { "id": "seed", "label": "Seed", "kind": "seed" },
          { "id": "regen", "label": "Regen docs", "kind": "cli", "cmd": "bun scripts/export-api-contract.ts" }
        ]
      },
      "automate": {
        "agents": ["api-docs-drift"],
        "schedules": [{ "agentId": "api-docs-drift", "spec": { "minute": 0, "hour": 9, "weekdays": [1] } }],
        "filesTickets": true
      }
    },
    {
      "id": "deploy",
      "title": "Deploy",
      "summary": "Prod URL day one: Docker → GHCR → DOKS → <project>.trevormil.com + cert-manager TLS.",
      "scope": "repo",
      "seed": { "root": "seed", "preserve": ["Dockerfile", "deploy/k8s/secret.example.yaml"] },
      "detect": { "markers": ["deploy/k8s/kustomization.yaml"], "requireAll": ["deploy/k8s/kustomization.yaml"] },
      "surface": {
        "adminLabel": "Deploy",
        "group": "infra",
        "docPath": "deploy/k8s/README.md",
        "data": [{ "kind": "cli", "cmd": "kubectl get pods -o json" }],
        "widgets": [{ "kind": "table", "source": 0, "title": "Pods" }],
        "actions": [
          { "id": "seed", "label": "Seed", "kind": "seed" },
          { "id": "deploy", "label": "Deploy", "kind": "cli", "cmd": "bash deploy/k8s/deploy.sh" },
          { "id": "rollout", "label": "Rollout status", "kind": "cli", "cmd": "kubectl rollout status deploy -n $PROJECT" }
        ]
      },
      "automate": {
        "agents": [],
        "schedules": [],
        "filesTickets": true
      }
    },
    {
      "id": "observability",
      "title": "Observability",
      "summary": "/metrics endpoint + Loki log driver + structured logging; queries Prometheus/Loki.",
      "scope": "repo",
      "seed": { "root": "seed", "preserve": ["src/telemetry.ts"], "gitignore": [".TerMinal/telemetry/"] },
      "detect": { "markers": ["observability/README.md"], "requireAll": ["observability/README.md"] },
      "surface": {
        "adminLabel": "Observability",
        "group": "observability",
        "docPath": "observability/README.md",
        "data": [{ "kind": "http", "url": "http://localhost:3000/metrics" }],
        "widgets": [{ "kind": "chart", "source": 0, "title": "Metrics" }],
        "actions": [{ "id": "seed", "label": "Seed", "kind": "seed" }]
      },
      "automate": {
        "agents": ["perf"],
        "schedules": [{ "agentId": "perf", "spec": { "minute": 0, "hour": 9, "weekdays": [1] } }],
        "filesTickets": true
      }
    },
    {
      "id": "testing",
      "title": "Testing & Coverage",
      "summary": "Test framework + example tests + coverage threshold + coverage cron.",
      "scope": "repo",
      "seed": { "root": "seed" },
      "detect": { "markers": ["docs/runbooks/testing.md"], "requireAll": ["docs/runbooks/testing.md"] },
      "surface": {
        "adminLabel": "Testing & Coverage",
        "group": "quality",
        "docPath": "docs/runbooks/testing.md",
        "data": [{ "kind": "cli", "cmd": "bun test --coverage 2>&1 | tail -20" }],
        "widgets": [{ "kind": "stat", "source": 0, "title": "Coverage" }],
        "actions": [
          { "id": "seed", "label": "Seed", "kind": "seed" },
          { "id": "test", "label": "Run tests", "kind": "cli", "cmd": "bun test" },
          { "id": "cov", "label": "Toggle coverage cron", "kind": "toggle-schedule", "agentId": "coverage" }
        ]
      },
      "automate": {
        "agents": ["testing", "coverage"],
        "schedules": [{ "agentId": "coverage", "spec": { "minute": 0, "hour": 8 } }],
        "filesTickets": true
      }
    }
  ],
  "profiles": {
    "web-service": ["health", "feedback", "api-docs", "deploy", "observability", "testing"],
    "library": ["health", "api-docs", "testing"],
    "cli": ["health", "testing"],
    "worker": ["health", "observability", "deploy", "testing"]
  }
}
